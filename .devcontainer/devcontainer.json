{
  "name": "FINPAY SOC",
  "dockerComposeFile": "docker-compose.yml",
  "service": "app",
  "workspaceFolder": "/workspaces/${localWorkspaceFolderBasename}",
  "forwardPorts": [8080],
  "portsAttributes": {
    "8080": { "label": "FINPAY SOC (live preview)", "onAutoForward": "openPreview" },
    "5432": { "label": "PostgreSQL", "onAutoForward": "ignore" }
  },
  "postCreateCommand": "bash .devcontainer/setup.sh",
  "postStartCommand": "bash .devcontainer/start.sh",
  "customizations": {
    "vscode": {
      "extensions": ["dbaeumer.vscode-eslint", "esbenp.prettier-vscode", "bradlc.vscode-tailwindcss"]
    },
    "codespaces": { "openFiles": ["README.md", ".devcontainer/README.md"] }
  },
  "hostRequirements": { "cpus": 2, "memory": "4gb" }
}
