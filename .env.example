# ---------------------------------------------------------------------------
# FINPAY SOC configuration. Copy to .env (or run ./scripts/setup.sh) and fill in.
# Never commit .env — it holds secrets.
# ---------------------------------------------------------------------------

# Public address of the SOC. DNS for this name must point at the server.
SOC_DOMAIN=soc.finpaytech.com
APP_URL=https://soc.finpaytech.com
# Let's Encrypt certificate-expiry notices
ACME_EMAIL=security@finpaytech.com
ORG_NAME=FINPAYTECH

# Secrets — generate each with:  openssl rand -hex 32
APP_SECRET=
POSTGRES_PASSWORD=
SOC_APP_DB_PASSWORD=

# --- Access control -------------------------------------------------------
# The first Security Administrator. Sign up with this address (or Google) and
# you are approved automatically; or run: docker compose run --rm migrate node_modules/.bin/tsx scripts/create-admin.ts --email ...
BOOTSTRAP_ADMIN_EMAIL=masudn058@gmail.com
# Only these email domains may request access (comma separated). Empty = any.
ALLOWED_EMAIL_DOMAINS=finpaytech.com
# Self-service "request access" (always needs admin approval). false = invite only.
ALLOW_SIGNUP=true
# Authenticator-app 2FA mandatory for every user.
REQUIRE_MFA=true
SESSION_IDLE_HOURS=12
SESSION_MAX_DAYS=7

# --- Google sign-in (optional) ---------------------------------------------
# Google Cloud Console → APIs & Services → Credentials → OAuth client (Web).
# Authorised redirect URI: https://<SOC_DOMAIN>/api/auth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# --- Email (optional; enables alert emails, verification, password reset) ---
# Any SMTP provider works (Microsoft 365, Google Workspace, Amazon SES, Mailgun...).
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM="FINPAY SOC <soc-alerts@finpaytech.com>"

# --- Sending issues to developer teams (optional) ----------------------------
# Issues go to each team's emails (SMTP above), Telegram group and WhatsApp numbers
# (set per team in Settings → Developer teams). Leave a channel empty to skip it.
# Telegram: create a bot with @BotFather, add it to the team's group.
TELEGRAM_BOT_TOKEN=
# WhatsApp Business Cloud API (Meta). Free-form text only reaches people who messaged
# the number in the last 24h; set WHATSAPP_TEMPLATE to an approved template whose single
# body variable ({{1}}) receives the issue summary + link.
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_TEMPLATE=
WHATSAPP_TEMPLATE_LANG=en
# How long the no-login issue links sent to developers stay valid.
ISSUE_LINK_DAYS=14

# --- Monitoring --------------------------------------------------------------
# Load the FINPAYTECH demo data on first start (remove later with scripts/seed-demo.ts --remove).
SEED_DEMO=true
# External checks never probe private/reserved IPs. Only enable if you know why.
ALLOW_PRIVATE_TARGETS=false
CHECK_CONCURRENCY=8
INGEST_RATE_PER_MINUTE=1200
BACKUP_KEEP_DAYS=14
